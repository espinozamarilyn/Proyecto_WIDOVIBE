---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ChatMod | Tu espacio para conectar">

  <main class="min-h-screen overflow-hidden bg-slate-50">

    <!-- Navegación -->
    <header class="relative z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">

        <a href="/" class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-200">
            <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" stroke="currentColor" stroke-width="2">
              <path d="M21 11.5a8.5 8.5 0 0 1-12.8 7.3L3 20l1.2-4.8A8.5 8.5 0 1 1 21 11.5Z" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M8 11h.01M12 11h.01M16 11h.01" stroke-linecap="round" stroke-width="3"/>
            </svg>
          </div>

          <span class="text-2xl font-extrabold tracking-tight text-slate-900">
            Chat<span class="text-indigo-600">Mod</span>
          </span>
        </a>

        <div class="hidden items-center gap-9 md:flex">
          <a href="#inicio" class="text-sm font-semibold text-slate-600 transition hover:text-indigo-600">Inicio</a>
          <a href="#funciones" class="text-sm font-semibold text-slate-600 transition hover:text-indigo-600">Funciones</a>
          <a href="#comunidades" class="text-sm font-semibold text-slate-600 transition hover:text-indigo-600">Comunidades</a>
        </div>

        <div class="flex items-center gap-3">
          <a href="/login/" class="hidden rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-100 sm:block">
            Iniciar sesión
          </a>

          <a href="/registro/" class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-700">
            Registrarse
          </a>
        </div>

      </nav>
    </header>

    <!-- Hero -->
    <section id="inicio" class="relative px-6 pb-24 pt-20 lg:px-10 lg:pb-32 lg:pt-28">

      <div class="pointer-events-none absolute -left-40 top-10 h-96 w-96 rounded-full bg-indigo-200/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-violet-200/30 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2">

        <!-- Texto principal -->
        <div class="max-w-2xl">

          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700">
            <span class="h-2 w-2 rounded-full bg-green-500"></span>
            Un nuevo espacio para conectar
          </div>

          <h1 class="text-5xl font-black leading-tight tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
            Conecta.
            <span class="text-indigo-600">Conversa.</span>
            Comparte.
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-8 text-slate-600">
            Todo lo que necesitas para comunicarte en un solo lugar.
            Habla con tus amigos, comparte archivos y crea comunidades
            donde tus ideas puedan crecer.
          </p>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">

            <a
              href="/registro/"
              class="inline-flex items-center justify-center gap-3 rounded-2xl bg-indigo-600 px-8 py-4 font-bold text-white shadow-xl shadow-indigo-200 transition hover:-translate-y-1 hover:bg-indigo-700"
            >
              Comenzar ahora

              <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14m-7-7 7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            <a
              href="#funciones"
              class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-8 py-4 font-bold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-600"
            >
              Explorar funciones
            </a>

          </div>

          <div class="mt-12 flex flex-wrap items-center gap-6 text-sm text-slate-500">
            <div class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-green-600" stroke="currentColor" stroke-width="2">
                <path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Conversaciones privadas
            </div>

            <div class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-green-600" stroke="currentColor" stroke-width="2">
                <path d="m5 12 4 4L19 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Comunidades
            </div>
          </div>

        </div>

        <!-- Vista previa de la aplicación -->
        <div class="relative mx-auto w-full max-w-xl">

          <div class="absolute -right-5 -top-8 h-32 w-32 rounded-full bg-violet-200/60 blur-2xl"></div>
          <div class="absolute -bottom-8 -left-8 h-40 w-40 rounded-full bg-indigo-200/60 blur-2xl"></div>

          <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-300/60">

            <!-- Barra superior -->
            <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">

              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-lg font-black text-white">
                  C
                </div>

                <div>
                  <p class="font-extrabold text-slate-900">ChatMod</p>
                  <p class="text-xs text-slate-400">Tu espacio de conexión</p>
                </div>
              </div>

              <div class="flex gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              </div>

            </div>

            <div class="grid grid-cols-[125px_1fr] sm:grid-cols-[155px_1fr]">

              <!-- Conversaciones -->
              <aside class="border-r border-slate-100 bg-slate-50/70 p-3 sm:p-4">

                <p class="mb-4 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">
                  Mensajes
                </p>

                <div class="space-y-4">

                  <div class="flex items-center gap-2 rounded-xl bg-indigo-50 p-2">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-200 text-xs font-bold text-indigo-700">A</div>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold text-indigo-700">Andrea</p>
                      <p class="truncate text-[10px] text-slate-400">¡Hola! ¿Cómo estás?</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 p-1">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-pink-100 text-xs font-bold text-pink-700">M</div>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold text-slate-700">Miguel</p>
                      <p class="truncate text-[10px] text-slate-400">Nos vemos mañana</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 p-1">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">D</div>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold text-slate-700">Desarrollo</p>
                      <p class="truncate text-[10px] text-slate-400">Nuevo mensaje</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 p-1">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-bold text-amber-700">L</div>
                    <div class="min-w-0">
                      <p class="truncate text-xs font-bold text-slate-700">Lucía</p>
                      <p class="truncate text-[10px] text-slate-400">¡Perfecto!</p>
                    </div>
                  </div>

                </div>

              </aside>

              <!-- Chat -->
              <div class="flex min-h-[330px] flex-col p-4 sm:p-5">

                <div class="mb-7 flex items-center gap-3 border-b border-slate-100 pb-4">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 font-bold text-indigo-700">A</div>
                  <div>
                    <p class="text-sm font-bold text-slate-800">Andrea López</p>
                    <p class="text-[10px] text-green-600">● En línea</p>
                  </div>
                </div>

                <div class="flex flex-1 flex-col gap-4">

                  <p class="text-center text-[10px] font-medium text-slate-400">
                    HOY, 10:42 AM
                  </p>

                  <div class="max-w-[85%] self-start rounded-2xl rounded-tl-sm bg-slate-100 p-3">
                    <p class="text-xs leading-5 text-slate-700">
                      ¡Hola! ¿Ya viste la nueva comunidad que creamos?
                    </p>
                    <p class="mt-1 text-right text-[9px] text-slate-400">10:42</p>
                  </div>

                  <div class="max-w-[85%] self-end rounded-2xl rounded-tr-sm bg-indigo-600 p-3 text-white">
                    <p class="text-xs leading-5">
                      ¡Sí! Me encanta. Podemos organizar todo por canales.
                    </p>
                    <p class="mt-1 text-right text-[9px] text-indigo-200">10:43 ✓✓</p>
                  </div>

                  <div class="max-w-[85%] self-start rounded-2xl rounded-tl-sm bg-slate-100 p-3">
                    <p class="text-xs leading-5 text-slate-700">
                      Exactamente, será mucho más fácil compartir ideas.
                    </p>
                    <p class="mt-1 text-right text-[9px] text-slate-400">10:44</p>
                  </div>

                </div>

                <div class="mt-5 flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3">
                  <span class="text-lg text-slate-400">＋</span>
                  <span class="flex-1 text-xs text-slate-400">Escribe un mensaje...</span>
                  <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white">
                    <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="2">
                      <path d="m22 2-7 20-4-9-9-4Z" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M22 2 11 13" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>

              </div>

            </div>

          </div>

          <!-- Tarjeta flotante -->
          <div class="absolute -bottom-7 -left-5 hidden items-center gap-3 rounded-2xl border border-slate-100 bg-white p-4 shadow-xl sm:flex">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-100 text-xl">
              <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 text-green-700" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2m8-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-extrabold text-slate-800">Comunidades</p>
              <p class="text-xs text-slate-400">Conecta con todos</p>
            </div>
          </div>

        </div>

      </div>

    </section>

    <!-- Funciones -->
    <section id="funciones" class="border-y border-slate-100 bg-white px-6 py-24 lg:px-10">

      <div class="mx-auto max-w-7xl">

        <div class="mx-auto mb-16 max-w-2xl text-center">
          <span class="text-sm font-extrabold uppercase tracking-widest text-indigo-600">
            Todo en un solo lugar
          </span>

          <h2 class="mt-4 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
            Una nueva forma de comunicarte
          </h2>

          <p class="mt-5 leading-7 text-slate-500">
            Herramientas diseñadas para que tus conversaciones sean más
            sencillas, organizadas y dinámicas.
          </p>
        </div>

        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">

          <!-- Mensajes -->
          <article class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-indigo-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M21 11.5a8.5 8.5 0 0 1-12.8 7.3L3 20l1.2-4.8A8.5 8.5 0 1 1 21 11.5Z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Mensajes privados</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Conversa individualmente o crea grupos con tus amigos y contactos.
            </p>
          </article>

          <!-- Comunidades -->
          <article id="comunidades" class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-violet-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-100 text-violet-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Comunidades</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Crea espacios públicos o privados y reúne personas con intereses comunes.
            </p>
          </article>

          <!-- Canales -->
          <article class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-blue-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-blue-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M4 4h16v16H4zM8 9h8M8 13h5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Canales organizados</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Organiza tus comunidades mediante canales de conversación y anuncios.
            </p>
          </article>

          <!-- Archivos -->
          <article class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-amber-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6M8 13h8M8 17h8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Compartir archivos</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Envía imágenes, documentos y archivos directamente en tus conversaciones.
            </p>
          </article>

          <!-- Contactos -->
          <article class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-pink-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-pink-100 text-pink-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm11-1v6m-3-3h6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Gestión de contactos</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Encuentra usuarios, envía solicitudes y administra tus contactos.
            </p>
          </article>

          <!-- Privacidad -->
          <article class="rounded-3xl border border-slate-100 bg-slate-50 p-8 transition hover:-translate-y-1 hover:border-green-200 hover:bg-white hover:shadow-xl">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-green-700">
              <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.8">
                <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900">Privacidad y control</h3>
            <p class="mt-3 leading-7 text-slate-500">
              Administra permisos, bloqueos y configuraciones de privacidad.
            </p>
          </article>

        </div>

      </div>

    </section>

    <!-- Llamada a la acción -->
    <section class="px-6 py-24 lg:px-10">

      <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-indigo-600 px-8 py-16 text-center shadow-2xl shadow-indigo-200 sm:px-16">

        <div class="pointer-events-none absolute -left-20 -top-32 h-80 w-80 rounded-full border-[45px] border-white/5"></div>
        <div class="pointer-events-none absolute -bottom-40 -right-20 h-96 w-96 rounded-full border-[55px] border-white/5"></div>

        <div class="relative mx-auto max-w-2xl">

          <h2 class="text-3xl font-black leading-tight text-white sm:text-5xl">
            Tus conversaciones merecen un mejor espacio.
          </h2>

          <p class="mt-6 text-lg leading-8 text-indigo-100">
            Únete a ChatMod y comienza a conectar con las personas y comunidades que te importan.
          </p>

          <a
            href="/registro/"
            class="mt-9 inline-flex items-center gap-3 rounded-2xl bg-white px-8 py-4 font-extrabold text-indigo-700 shadow-lg transition hover:-translate-y-1 hover:bg-indigo-50"
          >
            Crear mi cuenta
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </div>

    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white px-6 py-8 lg:px-10">

      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-5 sm:flex-row">

        <a href="/" class="text-xl font-black tracking-tight text-slate-900">
          Chat<span class="text-indigo-600">Mod</span>
        </a>

        <p class="text-center text-sm text-slate-500">
          © 2026 ChatMod. Todos los derechos reservados.
        </p>

        <p class="text-sm font-medium text-slate-400">
          Conecta sin límites.
        </p>

      </div>

    </footer>

  </main>

</Layout>