
---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  active?: string;
}

const {
  title = "ChatMod",
  active = "mensajes"
} = Astro.props;

const menu = [
  { id: "mensajes", nombre: "Mensajes", icono: "💬", url: "/app/mensajes/" },
  { id: "contactos", nombre: "Contactos", icono: "👥", url: "/app/contactos/" },
  { id: "comunidades", nombre: "Comunidades", icono: "🌐", url: "/app/comunidades/" },
  { id: "notificaciones", nombre: "Notificaciones", icono: "🔔", url: "/app/notificaciones/" },
  { id: "perfil", nombre: "Mi perfil", icono: "👤", url: "/app/perfil/" },
  { id: "configuracion", nombre: "Configuración", icono: "⚙️", url: "/app/configuracion/" }
];
---

<Layout title={`${title} | ChatMod`}>
  <div class="flex min-h-screen bg-slate-50">

    <aside class="hidden w-64 shrink-0 flex-col border-r border-slate-200 bg-white md:flex">

      <a href="/app/mensajes/" class="flex h-20 items-center gap-3 border-b border-slate-100 px-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 font-black text-white">
          C
        </div>

        <span class="text-xl font-black text-slate-900">
          Chat<span class="text-indigo-600">Mod</span>
        </span>
      </a>

      <div class="flex-1 px-4 py-7">

        <p class="mb-4 px-3 text-xs font-extrabold uppercase tracking-widest text-slate-400">
          Menú principal
        </p>

        <nav class="space-y-2">
          {menu.map((item) => (
            <a
              href={item.url}
              class:list={[
                "flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-semibold transition",
                active === item.id
                  ? "bg-indigo-50 text-indigo-700"
                  : "text-slate-600 hover:bg-slate-50 hover:text-indigo-600"
              ]}
            >
              <span>{item.icono}</span>
              {item.nombre}
            </a>
          ))}
        </nav>

      </div>

      <div class="border-t border-slate-100 p-4">
        <button
          id="cerrar-sesion"
          type="button"
          class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left text-sm font-semibold text-red-500 transition hover:bg-red-50"
        >
          <span>↪</span>
          Cerrar sesión
        </button>
      </div>

    </aside>

    <div class="flex min-w-0 flex-1 flex-col">

      <header class="flex h-20 items-center justify-between border-b border-slate-200 bg-white px-5 sm:px-8">

        <div>
          <h1 class="text-lg font-extrabold text-slate-900">{title}</h1>
          <p id="bienvenida-usuario" class="text-xs text-slate-400">
            Bienvenido a ChatMod
          </p>
        </div>

        <div class="flex items-center gap-3">

          <a
            href="/app/notificaciones/"
            aria-label="Notificaciones"
            class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-50 text-lg transition hover:bg-indigo-50"
          >
            🔔
          </a>

          <a
            href="/app/perfil/"
            id="usuario-avatar"
            aria-label="Mi perfil"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-100 font-bold text-indigo-700"
          >
            U
          </a>

        </div>

      </header>

      <nav class="flex gap-2 overflow-x-auto border-b border-slate-200 bg-white px-4 py-3 md:hidden">
        {menu.map((item) => (
          <a
            href={item.url}
            class:list={[
              "shrink-0 rounded-xl px-3 py-2 text-xs font-semibold",
              active === item.id
                ? "bg-indigo-600 text-white"
                : "bg-slate-100 text-slate-600"
            ]}
          >
            {item.icono} {item.nombre}
          </a>
        ))}

        <button
          id="cerrar-sesion-movil"
          type="button"
          class="shrink-0 rounded-xl bg-red-50 px-3 py-2 text-xs font-semibold text-red-600"
        >
          Cerrar sesión
        </button>
      </nav>

      <main class="flex-1 p-5 sm:p-8">
        <slot />
      </main>

    </div>
  </div>
</Layout>

<script>
  import { authGuard } from '../utils/auth.guard';
  import { authService } from '../services/api/auth.service';

  async function inicializarAplicacion() {
    const autorizado = await authGuard.protegerRuta();

    if (!autorizado) {
      return;
    }

    const usuario = authService.obtenerUsuarioGuardado();

    if (usuario) {
      const bienvenida = document.getElementById('bienvenida-usuario');
      const avatar = document.getElementById('usuario-avatar');

      if (bienvenida) {
        bienvenida.textContent = `Hola, ${usuario.nombre_completo}`;
      }

      if (avatar) {
        const iniciales = usuario.nombre_completo
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((parte) => parte.charAt(0).toUpperCase())
          .join('');

        avatar.textContent = iniciales || 'U';
      }
    }

    const cerrarSesion = () => {
      authService.cerrarSesion();
      window.location.replace('/login/');
    };

    document
      .getElementById('cerrar-sesion')
      ?.addEventListener('click', cerrarSesion);

    document
      .getElementById('cerrar-sesion-movil')
      ?.addEventListener('click', cerrarSesion);
  }

  inicializarAplicacion();
</script>
