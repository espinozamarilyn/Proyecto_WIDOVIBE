---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
}

const { title = "Acceso | ChatMod" } = Astro.props;
---

<Layout title={title}>
  <main class="flex min-h-screen items-center justify-center bg-slate-50 px-5 py-10">
    <div class="w-full max-w-md">
      <a href="/" class="mb-8 flex items-center justify-center gap-3">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-600 text-xl font-black text-white">
          C
        </div>
        <span class="text-3xl font-black text-slate-900">
          Chat<span class="text-indigo-600">Mod</span>
        </span>
      </a>

      <div class="rounded-3xl border border-slate-100 bg-white p-8 shadow-xl shadow-slate-200/50 sm:p-10">
        <slot />
      </div>

      <p class="mt-8 text-center text-sm text-slate-400">
        © 2026 ChatMod. Todos los derechos reservados.
      </p>
    </div>
  </main>
</Layout>